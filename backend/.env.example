# Gmail sender account
SMTP_FROM_EMAIL=marketing@spatialedge.ai
# Generate at: myaccount.google.com → Security → App passwords
SMTP_PASSWORD=your-gmail-app-password

# GCS bucket for profile photo uploads
GCS_BUCKET_NAME=your-project-id-signature-photos

# GCS service account credentials — paste the full JSON content here
# (Railway/cloud: set this env var; local: leave unset and use GOOGLE_APPLICATION_CREDENTIALS instead)
# To encode: base64 < service-account.json | tr -d '\n'
GOOGLE_CREDENTIALS_JSON=

# Public URL of this service — used to build image URLs in emails
# Set to your Railway public URL once deployed, e.g.:
# SITE_URL=https://your-service.up.railway.app
SITE_URL=http://localhost:8080

# Restrict CORS in production — comma-separated origins
# ALLOWED_ORIGINS=https://your-service.up.railway.app
